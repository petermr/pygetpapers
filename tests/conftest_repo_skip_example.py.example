#!/usr/bin/env python3
"""
Example implementation of repository test skipping.

This file demonstrates Strategy 6 (Hybrid Approach) combining:
- Pytest markers for command-line filtering
- Environment variables for CI/CD

To use this, rename to conftest.py or merge into existing conftest.py
"""

import os
import pytest

# Import existing connectivity test
from test_utils import test_redalyc_connectivity


def pytest_configure(config):
    """Configure pytest with custom markers."""
    config.addinivalue_line(
        "markers", "redalyc: marks tests that require Redalyc connectivity"
    )
    config.addinivalue_line(
        "markers", "scielo: marks tests that require SciELO connectivity"
    )
    config.addinivalue_line(
        "markers", "biorxiv: marks tests that require BioRxiv connectivity"
    )
    config.addinivalue_line(
        "markers", "skip_if_redalyc_down: marks tests to skip if Redalyc is down"
    )


def pytest_collection_modifyitems(config, items):
    """
    Modify test collection to skip repository-specific tests.
    
    Supports:
    1. Environment variables: SKIP_REDALYC=1, SKIP_SCIELO=1, SKIP_BIORXIV=1
    2. Pytest markers: -m "not redalyc"
    3. Automatic skipping if repository is down (for Redalyc)
    """
    skip_repos = set()
    
    # Check environment variables (CI/CD friendly)
    if os.getenv("SKIP_REDALYC", "").lower() in ("1", "true", "yes"):
        skip_repos.add("redalyc")
        print("⚠️  Skipping Redalyc tests (SKIP_REDALYC=1)")
    
    if os.getenv("SKIP_SCIELO", "").lower() in ("1", "true", "yes"):
        skip_repos.add("scielo")
        print("⚠️  Skipping SciELO tests (SKIP_SCIELO=1)")
    
    if os.getenv("SKIP_BIORXIV", "").lower() in ("1", "true", "yes"):
        skip_repos.add("biorxiv")
        print("⚠️  Skipping BioRxiv tests (SKIP_BIORXIV=1)")
    
    # Check marker expressions (command-line friendly)
    marker_expr = config.getoption("-m", default="")
    if marker_expr:
        if "not redalyc" in marker_expr or "not redalyc" in marker_expr.replace(" ", ""):
            skip_repos.add("redalyc")
        if "not scielo" in marker_expr or "not scielo" in marker_expr.replace(" ", ""):
            skip_repos.add("scielo")
        if "not biorxiv" in marker_expr or "not biorxiv" in marker_expr.replace(" ", ""):
            skip_repos.add("biorxiv")
    
    # Test Redalyc connectivity (existing behavior)
    if "redalyc" not in skip_repos:
        print("\n🔍 Testing Redalyc connectivity for test collection...")
        is_redalyc_connected, error_msg = test_redalyc_connectivity(timeout=5)
        
        if not is_redalyc_connected:
            print(f"⚠️  Redalyc appears to be down: {error_msg}")
            print("   Tests marked with @pytest.mark.skip_if_redalyc_down will be skipped")
            # Don't add to skip_repos - let individual decorators handle it
    
    # Skip tests based on repository name in nodeid or markers
    skipped_count = 0
    for item in items:
        item_repos = []
        
        # Check by marker
        if hasattr(item, 'pytestmark'):
            for mark in item.pytestmark:
                if mark.name in ("redalyc", "scielo", "biorxiv"):
                    item_repos.append(mark.name)
        
        # Check by nodeid (test file/function name)
        nodeid_lower = item.nodeid.lower()
        if "redalyc" in nodeid_lower:
            item_repos.append("redalyc")
        if "scielo" in nodeid_lower:
            item_repos.append("scielo")
        if "biorxiv" in nodeid_lower:
            item_repos.append("biorxiv")
        
        # Skip if repository is in skip list
        for repo in item_repos:
            if repo in skip_repos:
                item.add_marker(
                    pytest.mark.skip(reason=f"Skipping {repo} tests (disabled via config)")
                )
                skipped_count += 1
                break
    
    if skip_repos:
        print(f"\n📊 Skipped {skipped_count} tests for repositories: {', '.join(skip_repos)}")


@pytest.fixture(scope="session")
def redalyc_connectivity():
    """Fixture to check Redalyc connectivity."""
    is_connected, error_msg = test_redalyc_connectivity()
    return {"connected": is_connected, "error": error_msg}


@pytest.fixture(scope="session")
def skip_if_redalyc_down(redalyc_connectivity):
    """Fixture to skip tests if Redalyc is down."""
    if not redalyc_connectivity["connected"]:
        pytest.skip(f"Redalyc is down: {redalyc_connectivity['error']}")
    return True
